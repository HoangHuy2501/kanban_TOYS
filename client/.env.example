# Base URL của API backend của bạn.
# - Để trống: request đi thẳng theo path tuyệt đối (vd '/api/lines/...'),
#   dùng proxy VITE_PROXY_TARGET ở dev hoặc deploy cùng origin với API.
# - Đặt đầy đủ origin (vd 'http://192.168.1.10:8001'): mọi request '/api/...' sẽ được
#   gửi tới origin đó (backend của bạn cần bật CORS).
VITE_API_BASE_URL=

# Chỉ dùng khi chạy `npm run dev`: Vite sẽ chuyển tiếp mọi request '/api/*'
# sang target này (khỏi cần CORS trên backend).
# Ví dụ: VITE_PROXY_TARGET=http://localhost:8001
VITE_PROXY_TARGET=
